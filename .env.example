# Agent settings: place these in apps/agent/.env.
# Use the key for the selected provider; never expose keys to the browser.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Any OpenAI-compatible endpoint works: set OPENAI_BASE_URL and LLM_MODEL.
# claude-* uses Anthropic; everything else routes through the OpenAI-compatible
# endpoint. Blank or missing keys fail at startup.
# Keys are optional for BYOK-only hosting; visitors enter both keys in the app.
LLM_MODEL=chat-latest
OPENAI_BASE_URL=

# Jev (via OpenRouter) selects the renderer and visualization before each turn.
JEV_API_KEY=
JEV_MODEL=typesafe/jev-router

# Frontend settings: place these in apps/app/.env.local.
# LANGGRAPH_DEPLOYMENT_URL defaults to http://localhost:8123.
# LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123
# MCP_SERVER_URL=http://localhost:3100/mcp

# Rate limiting (per IP) — disabled by default
RATE_LIMIT_ENABLED=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=40
